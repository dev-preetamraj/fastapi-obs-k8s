# Version control
.git
.gitignore
.gitattributes

# Python build/runtime artifacts
.venv
__pycache__
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Tooling caches
.ruff_cache
.mypy_cache
.pytest_cache

# Editor / IDE
.vscode
.idea

# Agent / docs not needed in the image
AGENTS.md
CLAUDE.md
README.md
.claude

# Docker files themselves (not needed inside the image)
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
compose.yml
compose.*.yml

# Python version marker (uv reads requires-python from pyproject.toml)
.python-version
